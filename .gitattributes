# Auto-detect text files and normalize line endings to LF
* text=auto eol=lf

# Explicit text files
*.java text eol=lf
*.xml text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.properties text eol=lf
*.sh text eol=lf
mvnw text eol=lf

# Windows specific batch files
*.cmd text eol=crlf
*.bat text eol=crlf
mvnw.cmd text eol=crlf

# Binary files
*.jar binary
*.class binary
*.dll binary
*.so binary
*.dylib binary
*.exe binary
/.gitignore text eol=lf diff
